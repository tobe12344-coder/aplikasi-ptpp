/**
 * @fileoverview Firestore Security Rules for Aplikasi Laporan Kerusakan.
 * @version 4
 *
 * @security-model
 * - Role-based access control (RBAC) menggunakan Firestore document /users/{uid}.
 * - Hanya ada Admin dan Pelapor (User biasa).
 * - Semua data memerlukan autentikasi untuk dibaca.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isSignedIn() && getUserData().status == 'approved';
    }

    function isAdmin() {
      return isActiveUser() && getUserData().role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // =========================================================================
    // WHITELIST EMAILS
    // =========================================================================
    match /allowed_emails/{emailId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // USER PROFILES
    // =========================================================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Create: User pertama / terdaftar otomatis create
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId;

      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status);

      allow delete: if isAdmin();
    }
    
    // =========================================================================
    // COUNTERS (FOR SEQUENTIAL ID)
    // =========================================================================
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    // =========================================================================
    // DAMAGE REPORTS (LAPORAN KERUSAKAN)
    // =========================================================================
    match /damage_reports/{id} {
      allow read: if isSignedIn();
      // Pelapor (siapapun yang login) bisa membuat laporan
      allow create: if isSignedIn();
      // Hanya Admin atau Role Spesifik yang bisa memproses/update laporan
      allow update: if isAdmin() || (isActiveUser() && getUserData().role in ['spv_rsd', 'spv_maintenance', 'aftm', 'teknik']);
      // Hanya admin yang bisa menghapus
      allow delete: if isAdmin();
    }
  }
}
