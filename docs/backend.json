
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user of the application.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": {
          "type": "string",
          "enum": ["admin", "employee", "security", "receptionist", "teknik", "csbr", "tad", "ro", "pp"]
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved"]
        }
      },
      "required": ["uid", "email", "role", "status"]
    },
    "WorkshopMaterial": {
      "title": "WorkshopMaterial",
      "description": "Master data for workshop materials/filters.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string" },
        "location": { "type": "string" },
        "unit": { "type": "string" },
        "photo": { "type": "string", "format": "uri" }
      },
      "required": ["name", "code", "type", "unit"]
    },
    "WorkshopTransaction": {
      "title": "WorkshopTransaction",
      "description": "Log of incoming or outgoing workshop materials.",
      "type": "object",
      "properties": {
        "materialId": { "type": "string" },
        "materialName": { "type": "string" },
        "type": { "type": "string", "enum": ["Masuk", "Keluar"] },
        "quantity": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "officer": { "type": "string" },
        "notes": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["materialId", "type", "quantity", "date", "officer"]
    },
    "Guest": {
      "title": "Guest",
      "description": "Represents a guest entry in the guestbook.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "perusahaan": { "type": "string" },
        "yangDikunjungi": { "type": "string" },
        "maksudKunjungan": { "type": "string" },
        "tandaPengenal": { "type": "string" },
        "photoID": { "type": "string", "format": "uri" },
        "zona": { "type": "string", "enum": ["Bebas", "Terbatas", "Terlarang"] },
        "visitorCardNumber": { "type": "string" },
        "signature": { "type": "string", "format": "uri" },
        "photo": { "type": "string", "format": "uri" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "perusahaan", "yangDikunjungi", "maksudKunjungan", "tandaPengenal", "zona", "visitorCardNumber", "signature", "timestamp"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/workshop-materials/{id}": { "schema": { "$ref": "#/entities/WorkshopMaterial" }, "description": "Workshop master materials." },
    "/workshop-transactions/{id}": { "schema": { "$ref": "#/entities/WorkshopTransaction" }, "description": "Stock logs." },
    "/users/{userId}": { "schema": { "$ref": "#/entities/User" }, "description": "User profiles." },
    "/guests/{guestId}": { "schema": { "$ref": "#/entities/Guest" }, "description": "Guestbook entries." },
    "/attendance/{attendanceId}": { "schema": { "$ref": "#/entities/Attendance" }, "description": "Daily attendance records." },
    "/waste/{wasteId}": { "schema": { "$ref": "#/entities/Waste" }, "description": "B3 waste records." },
    "/sarpras/{sarprasId}": { "schema": { "$ref": "#/entities/Infrastructure" }, "description": "Infrastructure items." },
    "/supplies/{supplyId}": { "schema": { "$ref": "#/entities/Supply" }, "description": "Office supplies." },
    "/gate-pass/{id}": { "description": "Logs for vehicles entering/exiting." },
    "/penitipan/{id}": { "description": "Logs for items deposited at security post." }
  }
}
